import heapq
import os
import struct

import matplotlib.colors as mcolors
import matplotlib.pyplot as plt
import numpy as np


class DissolutionAnalyzer:
    def __init__(self):
        self.R_VOID = 0.0
        self.R_CALCITE = 1.0
        self.R_DOLOMITE = 10.0
        self.R_QUARTZ = float("inf")

    def read_dat_file(self, filename):
        with open(filename, "rb") as file:
            nx, ny, nz = struct.unpack("iii", file.read(12))
            raw = file.read(nx * ny * nz * 4)
        data = np.frombuffer(raw, dtype=np.int32).reshape((ny, nx))
        return data, nx, ny

    def calculate_difficulty(self, data):
        ny, nx = data.shape
        cost_map = np.zeros((ny, nx))
        cost_map[data == 2] = self.R_CALCITE
        cost_map[data == 3] = self.R_DOLOMITE
        cost_map[data == 4] = self.R_QUARTZ
        difficulty = np.full((ny, nx), float("inf"))

        accessible_voids = np.zeros((ny, nx), dtype=bool)
        void_queue = []
        for y in range(ny):
            for x in (0, nx - 1):
                if data[y, x] == 0 and not accessible_voids[y, x]:
                    accessible_voids[y, x] = True
                    void_queue.append((y, x))

        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]
        head = 0
        while head < len(void_queue):
            y, x = void_queue[head]
            head += 1
            for dy, dx in directions:
                y_next, x_next = y + dy, x + dx
                if 0 <= y_next < ny and 0 <= x_next < nx:
                    if data[y_next, x_next] == 0 and not accessible_voids[y_next, x_next]:
                        accessible_voids[y_next, x_next] = True
                        void_queue.append((y_next, x_next))

        priority_queue = []
        for y, x in zip(*np.where(accessible_voids)):
            difficulty[y, x] = 0.0
            heapq.heappush(priority_queue, (0.0, y, x))

        while priority_queue:
            current_cost, y, x = heapq.heappop(priority_queue)
            if current_cost > difficulty[y, x]:
                continue
            for dy, dx in directions:
                y_next, x_next = y + dy, x + dx
                if not (0 <= y_next < ny and 0 <= x_next < nx):
                    continue
                next_cost = cost_map[y_next, x_next]
                if not np.isfinite(next_cost):
                    continue
                updated_cost = current_cost + next_cost
                if updated_cost < difficulty[y_next, x_next]:
                    difficulty[y_next, x_next] = updated_cost
                    heapq.heappush(priority_queue, (updated_cost, y_next, x_next))

        return difficulty, accessible_voids

    def calculate_tdi(self, data, difficulty):
        solid_mask = data != 0
        solid_count = np.sum(solid_mask)
        if solid_count == 0:
            return 0.0
        characteristic_cost = data.shape[0] * self.R_CALCITE
        return np.sum(np.exp(-difficulty[solid_mask] / characteristic_cost)) / solid_count

    def calculate_srsa(self, data, accessible_voids):
        reactive_solids = (data == 2) | (data == 3)
        surface_area = 0
        surface_area += np.sum(accessible_voids[:, :-1] & reactive_solids[:, 1:])
        surface_area += np.sum(accessible_voids[:, 1:] & reactive_solids[:, :-1])
        surface_area += np.sum(accessible_voids[:-1, :] & reactive_solids[1:, :])
        surface_area += np.sum(accessible_voids[1:, :] & reactive_solids[:-1, :])
        return surface_area / data.size

    def visualize(self, difficulty, save_path):
        masked_difficulty = np.ma.masked_invalid(np.flipud(difficulty))
        vmax = np.percentile(masked_difficulty.compressed(), 98) if masked_difficulty.count() else 1.0
        cmap = plt.cm.turbo_r.copy()
        cmap.set_bad("black")

        fig, axis = plt.subplots(figsize=(8, 6))
        image = axis.imshow(masked_difficulty, cmap=cmap, norm=mcolors.PowerNorm(gamma=0.4, vmin=0, vmax=vmax))
        axis.axis("off")
        colorbar = fig.colorbar(image, ax=axis, fraction=0.046, pad=0.04)
        colorbar.set_label("Dissolution Cost", rotation=270, labelpad=15)
        fig.tight_layout()
        fig.savefig(save_path, dpi=200, bbox_inches="tight")
        plt.close(fig)


if __name__ == "__main__":
    input_dir = "11"
    output_dir = "dissolution_results"
    if not os.path.isdir(input_dir):
        raise FileNotFoundError(f"Input directory not found: {input_dir}")
    os.makedirs(output_dir, exist_ok=True)

    file_list = [
        "geo_00014000", "geo_00014100", "geo_00014200", "geo_00014300",
        "geo_00014400", "geo_00014500", "geo_00014600", "geo_00014700",
        "geo_00014800", "geo_00014900", "geo_00015000", "Case_12",
    ]
    analyzer = DissolutionAnalyzer()
    for base_name in file_list:
        data_path = os.path.join(input_dir, f"{base_name}.dat")
        if not os.path.isfile(data_path):
            continue

        data, _, _ = analyzer.read_dat_file(data_path)
        difficulty, accessible_voids = analyzer.calculate_difficulty(data)
        tdi = analyzer.calculate_tdi(data, difficulty)
        srsa = analyzer.calculate_srsa(data, accessible_voids)
        output_name = f"{base_name}_TDI_{tdi:.4f}_SRSA_{srsa:.4f}.png"
        analyzer.visualize(difficulty, os.path.join(output_dir, output_name))
        print(f"{base_name}: TDI={tdi:.4f}, SRSA={srsa:.4f}")
